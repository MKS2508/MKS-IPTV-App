---
/**
 * @file Componente Astro wrapper para GlassEffect.
 * @author MKS
 */

import { GlassEffect } from './GlassEffect.tsx';
import type { GlassEffectProps } from './types';

export interface Props extends GlassEffectProps {}

const {
  preset = 'dock',
  config = {},
  draggable = true,
  initialPosition = { x: 50, y: 50 },
  className = '',
  onMove,
} = Astro.props;
---

<GlassEffect
  client:load
  preset={preset}
  config={config}
  draggable={draggable}
  initialPosition={initialPosition}
  className={className}
  onMove={onMove}
>
  <slot />
</GlassEffect>