---
import Hero from './index.astro';
import type { HeroProps } from './types';

interface Props extends HeroProps {}

const props = Astro.props;
---

<div class="mobile-viewport-wrapper">
  <div class="viewport-label">Mobile View (375px)</div>
  <div class="mobile-container">
    <Hero {...props} />
  </div>
</div>

<style>
  .mobile-viewport-wrapper {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 20px;
    background: #1a1a1a;
    border-radius: 12px;
  }
  
  .viewport-label {
    position: absolute;
    top: -10px;
    left: 50%;
    transform: translateX(-50%);
    background: #1a1a1a;
    color: #888;
    padding: 4px 12px;
    font-size: 12px;
    font-family: monospace;
    border-radius: 4px;
    border: 1px solid #333;
    z-index: 10;
  }
  
  .mobile-container {
    width: 375px;
    height: 812px;
    overflow-x: hidden;
    overflow-y: auto;
    border: 2px solid #333;
    border-radius: 20px;
    background: #000;
    box-shadow: 
      0 0 0 4px #1a1a1a,
      0 0 0 6px #444,
      0 10px 40px rgba(0, 0, 0, 0.5);
    position: relative;
  }
  
  /* Simular barra de estado del iPhone */
  .mobile-container::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 44px;
    background: rgba(0, 0, 0, 0.9);
    z-index: 5;
    border-radius: 20px 20px 0 0;
  }
  
  /* Ajustar el Hero dentro del contenedor móvil */
  .mobile-container :global(#hero-section) {
    min-height: 100vh;
    width: 375px;
  }
  
  /* Scrollbar estilizado */
  .mobile-container::-webkit-scrollbar {
    width: 4px;
  }
  
  .mobile-container::-webkit-scrollbar-track {
    background: #1a1a1a;
  }
  
  .mobile-container::-webkit-scrollbar-thumb {
    background: #444;
    border-radius: 2px;
  }
</style>