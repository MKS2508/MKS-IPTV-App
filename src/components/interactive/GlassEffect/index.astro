---
/**
 * Wrapper Astro para el componente GlassEffect
 * Proporciona integración con Astro y configuración SSR
 */

import type { GlassEffectProps } from './types';

export interface Props extends GlassEffectProps {}

const { 
  preset = 'dock',
  className = '',
  id = '',
  customConfig = {},
  ...props 
} = Astro.props;

// Generar ID único si no se proporciona
const componentId = id || `glass-effect-${Math.random().toString(36).substr(2, 9)}`;
---

<div class="glass-effect-wrapper" data-component="GlassEffect" data-preset={preset}>
  <div 
    id={componentId}
    class={`glass-effect-container ${className}`}
    data-glass-preset={preset}
    {...props}
  >
    <slot />
  </div>
</div>

<script>
  import { GlassEffect } from './GlassEffect.tsx';
  import { createElement } from 'react';
  import { createRoot } from 'react-dom/client';

  // Función para inicializar el componente
  function initializeGlassEffect() {
    const containers = document.querySelectorAll('[data-component="GlassEffect"]');
    
    containers.forEach((container) => {
      const glassContainer = container.querySelector('.glass-effect-container');
      if (!glassContainer) return;

      const preset = container.getAttribute('data-preset') || 'dock';
      const componentId = glassContainer.id;
      
      // Obtener contenido del slot
      const slotContent = glassContainer.innerHTML;
      
      // Limpiar el contenedor
      glassContainer.innerHTML = '';
      
      // Crear elemento React
      const root = createRoot(glassContainer);
      
      // Props del componente
      const props = {
        preset,
        id: componentId,
        children: slotContent ? createElement('div', { 
          dangerouslySetInnerHTML: { __html: slotContent } 
        }) : null,
      };
      
      // Renderizar componente React
      root.render(createElement(GlassEffect, props));
    });
  }

  // Inicializar cuando el DOM esté listo
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeGlassEffect);
  } else {
    initializeGlassEffect();
  }

  // Reinicializar en navegación SPA
  document.addEventListener('astro:page-load', initializeGlassEffect);
</script>

<style>
  .glass-effect-wrapper {
    position: relative;
    display: inline-block;
  }

  .glass-effect-container {
    position: relative;
    min-width: 150px;
    min-height: 60px;
  }

  /* Estilos base para el loading state */
  .glass-effect-container:empty::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.1) 0%,
      rgba(255, 255, 255, 0.05) 100%
    );
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 16px;
    backdrop-filter: blur(10px);
    animation: glass-shimmer 2s infinite;
  }

  @keyframes glass-shimmer {
    0%, 100% {
      opacity: 0.5;
      transform: scale(1);
    }
    50% {
      opacity: 0.8;
      transform: scale(1.01);
    }
  }

  /* Responsividad */
  @media (max-width: 768px) {
    .glass-effect-container {
      min-width: 120px;
      min-height: 50px;
    }
  }

  @media (max-width: 480px) {
    .glass-effect-container {
      min-width: 100px;
      min-height: 40px;
    }
  }
</style>