# ═══════════════════════════════════════════════════════════════════════════
# TRANSMUX LOG VIEWER - Development Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════
# Copy this file to .tmuxdev.env and customize for your environment.
# All paths are relative to the project root unless absolute.

# ─────────────────────────────────────────────────────────────────────────────
# SESSION
# ─────────────────────────────────────────────────────────────────────────────
# Name of the tmux session
TMUX_SESSION_NAME="transmux-dev"

# ─────────────────────────────────────────────────────────────────────────────
# PATHS
# ─────────────────────────────────────────────────────────────────────────────
# Project root (auto-detected from script location, override if needed)
# PROJECT_ROOT="/path/to/transmux-log-viewer"

# TransmuxCore CLI location
TRANSMUX_DIR="/Volumes/KODAK1TB/MKS-IPTV-App/TransmuxCore"
TRANSMUX_CLI="${TRANSMUX_DIR}/.build/arm64-apple-macosx/debug/transmux-cli"

# Log file written by TransmuxCore CLI
LOG_FILE="/tmp/mks-iptv-transmux.log"

# Primary test file for CLI tests (used by ./dev.sh cli basic|seek)
PRIMARY_TEST_FILE="/Volumes/KODAK1TB/Crímenes Bellvitge (2026) 1x03.mkv"

# ─────────────────────────────────────────────────────────────────────────────
# PORTLESS (https://github.com/myorg/portless)
# ─────────────────────────────────────────────────────────────────────────────
# Enable portless mode (1 = enabled, 0 = disabled)
USE_PORTLESS=1

# Port for portless proxy (80 requires sudo, 1355 is default without sudo)
PORTLESS_PORT=80

# Portless route names (become name.localhost)
PL_BACKEND_NAME="transmux-api"
PL_FRONTEND_NAME="transmux-app"

# ─────────────────────────────────────────────────────────────────────────────
# DIRECT PORTS (when USE_PORTLESS=0)
# ─────────────────────────────────────────────────────────────────────────────
BACKEND_PORT=3000
FRONTEND_PORT=5173

# ─────────────────────────────────────────────────────────────────────────────
# PANE INDICES (tmux pane order)
# ─────────────────────────────────────────────────────────────────────────────
PANE_BACKEND=0
PANE_FRONTEND=1
PANE_LOG=2
PANE_CLI=3

# ─────────────────────────────────────────────────────────────────────────────
# TMUX THEME (cyberpunk colors)
# ─────────────────────────────────────────────────────────────────────────────
TMUX_COLOR_BLUE="#7aa2f7"
TMUX_COLOR_MUTED="#565f89"

# ─────────────────────────────────────────────────────────────────────────────
# PACKAGE FILTERS (bun --filter names)
# ─────────────────────────────────────────────────────────────────────────────
BACKEND_PACKAGE="@transmux-viewer/backend"
FRONTEND_PACKAGE="mks-iptv-client"
