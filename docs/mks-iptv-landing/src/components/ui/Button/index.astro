---
/**
 * @file Wrapper Astro para el componente Button universal con sistema de animación híbrido.
 * @description Soporta Framer Motion, GSAP y CSS transitions con detección automática
 * @author MKS
 */

import { Button } from './Button.tsx';
import type { AstroButtonProps } from './types';
import { AnimationEngineSelector } from './AnimationEngine';

export interface Props extends AstroButtonProps {
  /** Contexto de animación para optimización automática */
  animationContext?: 'button' | 'cta' | 'form' | 'hero';
}

const {
  children,
  text,
  variant = 'primary',
  size = 'md',
  width = 'auto',
  icon,
  loading = false,
  disabled = false,
  className = '',
  motionConfig,
  animationContext = 'button',
  id,
  as = 'button',
  ...restProps
} = Astro.props;

// Procesar configuración de animación
const processMotionConfig = () => {
  // Si no hay configuración, usar la óptima para el contexto
  if (!motionConfig) {
    const optimalConfig = AnimationEngineSelector.getOptimalConfig(animationContext);
    return {
      engine: optimalConfig.engine,
      preset: optimalConfig.preset,
      respectReducedMotion: true
    };
  }
  
  return motionConfig;
};

// Serializar motionConfig para que sea compatible con React
const finalMotionConfig = processMotionConfig();
const serializedMotionConfig = JSON.stringify(finalMotionConfig);

---

{as === 'link' ? (
  <Button 
    client:visible
    text={typeof children === 'string' ? children : text || 'Link'}
    variant={variant}
    size={size}
    width={width}
    icon={icon}
    loading={loading}
    disabled={disabled}
    className={className}
    motionConfigSerialized={serializedMotionConfig}
    animationContext={animationContext}
    id={id}
    as="link"
    href={restProps.href || '#'}
    external={restProps.external}
    {...restProps}
  />
) : (
  <Button 
    client:visible
    text={typeof children === 'string' ? children : text || 'Button'}
    variant={variant}
    size={size}
    width={width}
    icon={icon}
    loading={loading}
    disabled={disabled}
    className={className}
    motionConfigSerialized={serializedMotionConfig}
    animationContext={animationContext}
    id={id}
    as="button"
    {...restProps}
  />
)}