---
/**
 * Componente Header con navegación responsive y menú móvil.
 * Incluye logo, navegación principal, y funcionalidad de scroll.
 * 
 * @component
 * @param {string} currentPath - Ruta actual para highlighting de navegación
 * @param {boolean} showLogo - Mostrar logo en el header
 * @param {boolean} transparent - Header transparente inicial
 * @param {string} className - Clases CSS adicionales
 * 
 * @example
 * <Header currentPath="/installation" showLogo={true} transparent={false} />
 */

import { headerStyles, getNavLinkClasses, getMobileNavLinkClasses } from './styles';
import type { HeaderProps, NavigationItem } from './types';
import { strings } from '../../../i18n/strings/es-es';
import Button from '../../ui/Button/index.astro';

const {
  currentPath = '/',
  showLogo = true,
  transparent = false,
  className = ''
}: HeaderProps = Astro.props;

// Navegación principal usando strings localizadas
const navigationItems: NavigationItem[] = [
  { label: strings.nav.home, href: '/MKS-IPTV-App/' },
  { label: strings.nav.installation, href: '/MKS-IPTV-App/installation' },
  { label: strings.nav.downloads, href: '/MKS-IPTV-App/download' },
  { label: strings.nav.screenshots, href: '/MKS-IPTV-App/screenshots' },
  { 
    label: strings.nav.github, 
    href: 'https://github.com/MKS2508/MKS-IPTV-App', 
    isExternal: true,
    icon: 'github'
  }
];

// Determinar si un enlace está activo
function isActiveLink(href: string, currentPath: string): boolean {
  if (href === '/MKS-IPTV-App/' && currentPath === '/') return true;
  if (href !== '/MKS-IPTV-App/' && currentPath.startsWith(href.replace('/MKS-IPTV-App', ''))) return true;
  return false;
}

// Clases del header basadas en transparencia
const headerClasses = [
  headerStyles.container,
  transparent ? headerStyles.variants.transparent : headerStyles.variants.solid,
  className
].filter(Boolean).join(' ');
---

<header class={headerClasses} id="main-header" style="opacity: 0; transform: translateY(-100%); visibility: hidden;" transition:persist>
  <div class={headerStyles.inner}>
    <div class={headerStyles.content}>
      
      <!-- Logo y Branding -->
      {showLogo && (
        <div class={`${headerStyles.logo.container} logo-container`}>
          <a href="/" class="flex items-center space-x-3 group">
            <div class="relative">
              <div class="absolute inset-0 bg-app-accent/20 rounded-full blur-lg group-hover:blur-xl transition-all duration-300 group-hover:scale-110"></div>
              <img 
                src="/MKS-IPTV-App/images/logos/applogo.webp"
                alt="MKS-IPTV Logo"
                class={`${headerStyles.logo.image} relative z-10 group-hover:scale-110 transition-transform duration-300 drop-shadow-lg`}
                width="40"
                height="40"
              />
            </div>
            <span class={`${headerStyles.logo.text} group-hover:text-app-highlight transition-colors duration-300`}>
              MKS-IPTV
            </span>
          </a>
        </div>
      )}
      
      <!-- Navegación Desktop -->
      <nav class={headerStyles.nav.container} role="navigation" aria-label="Navegación principal">
        <ul class={headerStyles.nav.list}>
          {navigationItems.map((item) => {
            const isActive = isActiveLink(item.href, currentPath);
            const linkClasses = getNavLinkClasses(isActive, item.isExternal);
            
            return (
              <li class={headerStyles.nav.item}>
                <a 
                  href={item.href}
                  class={`${linkClasses} nav-link`}
                  aria-current={isActive ? 'page' : undefined}
                  target={item.isExternal ? '_blank' : undefined}
                  rel={item.isExternal ? 'noopener noreferrer' : undefined}
                >
                  {item.label}
                  {item.isExternal && (
                    <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  )}
                </a>
                {isActive && (
                  <div class={headerStyles.nav.activeIndicator}></div>
                )}
              </li>
            );
          })}
        </ul>
      </nav>
      
      <!-- Botón Menú Móvil -->
      <div class={`${headerStyles.mobileButton.container} mobile-button-container`}>
        <Button 
          variant="ghost"
          size="md"
          icon={{ lucide: 'Menu', position: 'only' }}
          motionConfig={{
            engine: 'framer',
            preset: 'scale'
          }}
          className={headerStyles.mobileButton.button}
          id="mobile-menu-button"
          aria-label="Abrir menú de navegación"
        />
      </div>
    </div>
  </div>
  
  <!-- Menú Móvil -->
  <div 
    class={headerStyles.mobileMenu.overlay} 
    id="mobile-menu-overlay"
    style="display: none;"
  >
    <div class={`${headerStyles.mobileMenu.container} ${headerStyles.mobileMenu.hidden}`} id="mobile-menu">
      <div class={headerStyles.mobileMenu.content}>
        
        <!-- Header del menú móvil -->
        <div class={headerStyles.mobileMenu.header}>
          <div class={headerStyles.logo.container}>
            <div class="relative">
              <div class="absolute inset-0 bg-app-accent/25 rounded-full blur-md"></div>
              <img 
                src="/MKS-IPTV-App/images/logos/applogo.webp"
                alt="MKS-IPTV Logo"
                class="h-8 w-8 relative z-10 drop-shadow-lg"
                width="32"
                height="32"
              />
            </div>
            <span class="text-lg font-bold text-white drop-shadow-lg">MKS-IPTV</span>
          </div>
          <Button 
            variant="ghost"
            size="md"
            icon={{ lucide: 'X', position: 'only' }}
            motionConfig={{
              engine: 'framer',
              preset: 'rotate'
            }}
            className={headerStyles.mobileMenu.closeButton}
            id="mobile-menu-close"
            aria-label="Cerrar menú de navegación"
          />
        </div>
        
        <!-- Navegación móvil -->
        <nav class={headerStyles.mobileMenu.nav} role="navigation" aria-label="Navegación móvil">
          <ul class={headerStyles.mobileMenu.list}>
            {navigationItems.map((item) => {
              const isActive = isActiveLink(item.href, currentPath);
              const linkClasses = getMobileNavLinkClasses(isActive);
              
              return (
                <li class={headerStyles.mobileMenu.item}>
                  <a 
                    href={item.href}
                    class={linkClasses}
                    aria-current={isActive ? 'page' : undefined}
                    target={item.isExternal ? '_blank' : undefined}
                    rel={item.isExternal ? 'noopener noreferrer' : undefined}
                  >
                    {item.label}
                    {item.isExternal && (
                      <svg class="w-4 h-4 ml-2 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                      </svg>
                    )}
                  </a>
                </li>
              );
            })}
          </ul>
        </nav>
      </div>
    </div>
  </div>
</header>

<script>
  // import { gsap } from 'gsap';
  
  // Variable global para trackear estado del header
  (window as any).headerInitialized = (window as any).headerInitialized || false;
  
  // Funcionalidad del menú móvil y scroll
  const initHeader = () => {
    const header = document.getElementById('main-header');
    if (!header) return;
    
    // RESET STYLES - Limpiar estados previos para navegación SPA
    const logoContainer = header.querySelector('.logo-container');
    const navLinks = header.querySelectorAll('.nav-link');
    const mobileButton = header.querySelector('.mobile-button-container');
    
    // Reset transitions first
    [header, logoContainer, mobileButton, ...navLinks].forEach(element => {
      if (element) {
        (element as HTMLElement).style.transition = '';
      }
    });
    
    // DETECTAR SI TENEMOS HERO EN LA PÁGINA
    const hasHero = document.querySelector('#hero-section') || 
                   document.querySelector('.hero-section') || 
                   window.location.pathname === '/' || 
                   window.location.pathname === '/MKS-IPTV-App/';
    
    // DETECTAR SI EL HERO YA ESTÁ COMPLETAMENTE VISIBLE (usuario ya hizo scroll)
    const heroElement = document.querySelector('#hero-section');
    const isHeroCompleted = heroElement && (window as any).heroScrollCompleted;
    
    console.log('🔄 Header init:', {
      url: window.location.pathname,
      hasHero,
      heroElement: !!heroElement,
      isHeroCompleted,
      headerInitialized: (window as any).headerInitialized
    });
    
    // HEADER INITIAL STATES - Diferente comportamiento según contexto
    
    if (hasHero && !isHeroCompleted) {
      // CON HERO Y NO COMPLETADO: Set initial states para que Master Timeline los controle
      if (header) {
        header.style.opacity = '0';
        header.style.transform = 'translateY(-100%)';
        header.style.visibility = 'hidden';
      }
      
      if (logoContainer) {
        (logoContainer as HTMLElement).style.opacity = '0';
        (logoContainer as HTMLElement).style.visibility = 'hidden';
        (logoContainer as HTMLElement).style.transform = 'scale(0.5) translateY(-20px)';
      }
      
      navLinks.forEach((link) => {
        (link as HTMLElement).style.opacity = '0';
        (link as HTMLElement).style.visibility = 'hidden';
        (link as HTMLElement).style.transform = 'translateY(-30px)';
      });
      
      if (mobileButton) {
        (mobileButton as HTMLElement).style.opacity = '0';
        (mobileButton as HTMLElement).style.visibility = 'hidden';
        (mobileButton as HTMLElement).style.transform = 'scale(0.3) rotate(180deg)';
      }

      console.log('📋 Header elements prepared for Master Timeline control');
      
      // EXPONER ELEMENTOS PARA MASTER TIMELINE
      (window as any).headerElements = {
        header,
        logoContainer,
        navLinks,
        mobileButton
      };
      
      (window as any).headerInitialized = true;
    } else if (hasHero && isHeroCompleted) {
      // CON HERO PERO YA COMPLETADO: Mostrar header inmediatamente
      console.log('📋 Hero completed - showing header immediately');
      
      if (header) {
        header.style.opacity = '1';
        header.style.transform = 'translateY(0)';
        header.style.visibility = 'visible';
      }
      
      if (logoContainer) {
        (logoContainer as HTMLElement).style.opacity = '1';
        (logoContainer as HTMLElement).style.visibility = 'visible';
        (logoContainer as HTMLElement).style.transform = 'scale(1) translateY(0)';
        (logoContainer as HTMLElement).style.transition = 'none';
      }
      
      navLinks.forEach((link) => {
        (link as HTMLElement).style.opacity = '1';
        (link as HTMLElement).style.visibility = 'visible';
        (link as HTMLElement).style.transform = 'translateY(0)';
        (link as HTMLElement).style.transition = 'none';
      });
      
      if (mobileButton) {
        (mobileButton as HTMLElement).style.opacity = '1';
        (mobileButton as HTMLElement).style.visibility = 'visible';
        (mobileButton as HTMLElement).style.transform = 'scale(1) rotate(0deg)';
        (mobileButton as HTMLElement).style.transition = 'none';
      }
      
      (window as any).headerInitialized = true;
    } else {
      // SIN HERO: Mostrar header inmediatamente sin animaciones innecesarias
      
      // Verificar múltiples condiciones para detectar si el header ya está visible
      const isAlreadyVisible = (window as any).headerInitialized || 
                              header.style.opacity === '1' || 
                              getComputedStyle(header).opacity === '1' ||
                              header.style.visibility === 'visible' ||
                              getComputedStyle(header).visibility === 'visible';
      
      console.log('🔄 Header visibility check:', {
        headerInitialized: (window as any).headerInitialized,
        styleOpacity: header.style.opacity,
        computedOpacity: getComputedStyle(header).opacity,
        isAlreadyVisible
      });
      
      // Set header visible state FIRST
      if (header) {
        header.style.opacity = '1';
        header.style.transform = 'translateY(0)';
        header.style.visibility = 'visible';
      }
      
      if (isAlreadyVisible) {
        // Header ya visible - Set all elements to final state WITHOUT transitions
        console.log('📋 Header already visible - setting final state immediately');
        
        if (logoContainer) {
          (logoContainer as HTMLElement).style.opacity = '1';
          (logoContainer as HTMLElement).style.visibility = 'visible';
          (logoContainer as HTMLElement).style.transform = 'scale(1) translateY(0)';
          (logoContainer as HTMLElement).style.transition = 'none';
        }
        
        navLinks.forEach((link) => {
          (link as HTMLElement).style.opacity = '1';
          (link as HTMLElement).style.visibility = 'visible';
          (link as HTMLElement).style.transform = 'translateY(0)';
          (link as HTMLElement).style.transition = 'none';
        });
        
        if (mobileButton) {
          (mobileButton as HTMLElement).style.opacity = '1';
          (mobileButton as HTMLElement).style.visibility = 'visible';
          (mobileButton as HTMLElement).style.transform = 'scale(1) rotate(0deg)';
          (mobileButton as HTMLElement).style.transition = 'none';
        }
        
        // Force reflow to ensure styles are applied
        header.offsetHeight;
        
      } else {
        // Primera carga - Animate header elements on load para páginas sin Hero
        console.log('📋 Header first load - initializing with animation');
        
        setTimeout(() => {
          if (logoContainer) {
            (logoContainer as HTMLElement).style.opacity = '1';
            (logoContainer as HTMLElement).style.visibility = 'visible';
            (logoContainer as HTMLElement).style.transform = 'scale(1) translateY(0)';
            (logoContainer as HTMLElement).style.transition = 'all 0.6s ease-out';
          }
          
          navLinks.forEach((link, index) => {
            setTimeout(() => {
              (link as HTMLElement).style.opacity = '1';
              (link as HTMLElement).style.visibility = 'visible';
              (link as HTMLElement).style.transform = 'translateY(0)';
              (link as HTMLElement).style.transition = 'all 0.4s ease-out';
            }, index * 100);
          });
          
          if (mobileButton) {
            (mobileButton as HTMLElement).style.opacity = '1';
            (mobileButton as HTMLElement).style.visibility = 'visible';
            (mobileButton as HTMLElement).style.transform = 'scale(1) rotate(0deg)';
            (mobileButton as HTMLElement).style.transition = 'all 0.5s ease-out';
          }
        }, 200);
      }
      
      (window as any).headerInitialized = true;
    }
    const mobileMenuButton = document.getElementById('mobile-menu-button');
    const mobileMenuOverlay = document.getElementById('mobile-menu-overlay');
    const mobileMenu = document.getElementById('mobile-menu');
    const mobileMenuClose = document.getElementById('mobile-menu-close');
    
    let isMenuOpen = false;
    
    // Función para alternar el menú móvil
    function toggleMobileMenu() {
      isMenuOpen = !isMenuOpen;
      
      if (isMenuOpen) {
        if (mobileMenuOverlay) (mobileMenuOverlay as HTMLElement).style.display = 'block';
        setTimeout(() => {
          if (mobileMenu) {
            mobileMenu.classList.remove('translate-x-full');
            mobileMenu.classList.add('translate-x-0');
          }
        }, 10);
        document.body.style.overflow = 'hidden';
      } else {
        if (mobileMenu) {
          mobileMenu.classList.remove('translate-x-0');
          mobileMenu.classList.add('translate-x-full');
        }
        setTimeout(() => {
          if (mobileMenuOverlay) (mobileMenuOverlay as HTMLElement).style.display = 'none';
        }, 300);
        document.body.style.overflow = '';
      }
    }
    
    // Event listeners para el menú móvil
    mobileMenuButton?.addEventListener('click', toggleMobileMenu);
    mobileMenuClose?.addEventListener('click', toggleMobileMenu);
    mobileMenuOverlay?.addEventListener('click', (e) => {
      if (e.target === mobileMenuOverlay) {
        toggleMobileMenu();
      }
    });
    
    // Cerrar menú con Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isMenuOpen) {
        toggleMobileMenu();
      }
    });
    
    // DISABLED - Removed scroll listeners for virtual scroll mode
    // Header styles will be controlled by timeline progress instead
    
    // ACTUALIZAR ESTADOS ACTIVOS DE NAVEGACIÓN
    updateActiveNavigation();
  };

  // Función para determinar si un enlace está activo (duplicada del Astro scope)
  function isActiveLink(href: string, currentPath: string): boolean {
    // Normalizar rutas para comparación
    const normalizedHref = href.replace('/MKS-IPTV-App', '');
    const normalizedPath = currentPath.replace('/MKS-IPTV-App', '');
    
    // Home page
    if (normalizedHref === '/' && (normalizedPath === '/' || normalizedPath === '')) {
      return true;
    }
    
    // Otras páginas - match exacto o que empiece con la ruta
    if (normalizedHref !== '/' && normalizedPath.startsWith(normalizedHref)) {
      return true;
    }
    
    // Enlaces externos no se marcan como activos
    if (href.startsWith('http')) {
      return false;
    }
    
    return false;
  }

  // Variable para evitar ejecuciones duplicadas
  let lastNavigationUpdate = '';
  let navigationUpdateTimeout: number | null = null;

  // Función para actualizar la navegación activa (optimizada)
  function updateActiveNavigation() {
    const currentPath = window.location.pathname;
    
    // Evitar actualizaciones duplicadas para la misma ruta
    if (lastNavigationUpdate === currentPath) {
      return;
    }
    
    // Cancelar timeout anterior si existe
    if (navigationUpdateTimeout) {
      clearTimeout(navigationUpdateTimeout);
    }
    
    // Debounce para evitar múltiples ejecuciones
    navigationUpdateTimeout = setTimeout(() => {
      const navLinks = document.querySelectorAll('.nav-link');
      
      console.log('🔗 Updating navigation for path:', currentPath);
      
      // Remover todos los indicadores activos existentes
      const existingIndicators = document.querySelectorAll('.absolute.bottom-0.left-0.right-0.h-0\\.5.bg-gradient-to-r');
      existingIndicators.forEach(indicator => indicator.remove());
      
      // Actualizar cada enlace de navegación
      navLinks.forEach(link => {
        const href = link.getAttribute('href');
        if (!href) return;
        
        const isActive = isActiveLink(href, currentPath);
        const linkElement = link as HTMLElement;
        
        // Remover todas las clases de estado
        linkElement.classList.remove(
          'text-app-text-muted', 'hover:text-app-text', 'hover:scale-105', // default
          'text-app-accent', 'font-semibold' // active
        );
        
        if (isActive) {
          // Aplicar estilos activos
          linkElement.classList.add('text-app-accent', 'font-semibold');
          
          // Agregar indicador activo siguiendo la estructura del CSS
          const indicator = document.createElement('div');
          indicator.className = 'absolute bottom-0 left-0 right-0 h-0.5 bg-gradient-to-r from-app-accent to-app-highlight rounded-full';
          linkElement.parentElement?.appendChild(indicator);
          
          console.log('✅ Active link set:', href);
        } else {
          // Aplicar estilos por defecto
          linkElement.classList.add('text-app-text-muted', 'hover:text-app-text', 'hover:scale-105');
        }
      });
      
      lastNavigationUpdate = currentPath;
      navigationUpdateTimeout = null;
    }, 100); // Debounce de 100ms
  }

  // Función combinada para inicializar header y actualizar navegación
  function initHeaderAndNav() {
    initHeader();
    updateActiveNavigation(); // Una sola llamada con debouncing interno
  }

  // Función solo para actualizar navegación (más ligera)
  function updateNavOnly() {
    updateActiveNavigation(); // Una sola llamada con debouncing interno
  }

  // Inicializar header en carga inicial
  document.addEventListener('DOMContentLoaded', initHeaderAndNav);
  
  // Re-inicializar header en navegación SPA (para Astro view transitions)
  document.addEventListener('astro:page-load', initHeaderAndNav);
  
  // Eventos específicos de Astro ViewTransitions
  document.addEventListener('astro:before-preparation', updateNavOnly);
  document.addEventListener('astro:after-preparation', updateNavOnly);
  document.addEventListener('astro:before-swap', updateNavOnly);
  document.addEventListener('astro:after-swap', updateNavOnly);
  
  // Fallback para navegación manual
  window.addEventListener('popstate', () => {
    setTimeout(initHeaderAndNav, 100);
  });
  
  // Observer para cambios en el DOM (más robusto que polling)
  const urlObserver = new MutationObserver(() => {
    updateNavOnly();
  });
  
  // Iniciar observación del título (cambia con cada página)
  const titleElement = document.querySelector('title');
  if (titleElement) {
    urlObserver.observe(titleElement, { 
      childList: true, 
      characterData: true, 
      subtree: true 
    });
  }
  
  // Detectar cambios de URL para casos edge (backup)
  let currentUrl = window.location.href;
  setInterval(() => {
    if (window.location.href !== currentUrl) {
      currentUrl = window.location.href;
      updateNavOnly();
    }
  }, 500);
</script>